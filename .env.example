# Copy this template to .env and replace the placeholders locally.
# FastAPI and sync_crawled_syllabi.py automatically load the project-root .env file.
# Existing process environment variables take priority over .env values.

# Supabase project base URL, without /rest/v1. Optional for crawler --dry-run.
SUPABASE_URL=https://your-project-ref.supabase.co

# FastAPI public catalog and authenticated user requests.
# For a legacy anon key, leave SUPABASE_PUBLISHABLE_KEY empty and set SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side service_role JWT or sb_secret_ key for uploads and PDF access.
# Never use an anon/publishable key here.
# Keep the real key out of source control and frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth credentials for the API test guide. Fill these in only in your local .env.
API_TEST_EMAIL=
API_TEST_PASSWORD=

# Regular-course PDFs are collected by this project's scripts.syllabus module.
# Local output: ./crawled_syllabus (no external repository settings required).
