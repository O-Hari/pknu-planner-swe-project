# Copy this template to .env and replace the placeholders locally.
# sync_crawled_syllabi.py automatically loads the project-root .env file.
# Existing process environment variables take priority over .env values.

# Required for uploads (not required for --dry-run).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side service_role JWT or sb_secret_ key (both supported).
# Never use an anon/publishable key here.
# Keep the real key out of source control and frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Regular-course PDFs are collected by this project's scripts.syllabus module.
# Local output: ./crawled_syllabus (no external repository settings required).
